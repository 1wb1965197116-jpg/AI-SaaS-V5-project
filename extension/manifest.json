{
  "manifest_version": 3,
  "name": "AI Browser Translator V5",
  "version": "1.0.0",
  "description": "On-page AI translation with side-by-side English, dictation, camera OCR, and map directions.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "camera"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "AI Translate",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["translate.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
